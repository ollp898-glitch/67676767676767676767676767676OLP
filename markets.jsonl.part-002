buff.com. However, if https://www.dotabuff.com has not published final results within 2 hours after the event’s conclusion, a consensus of credible reporting may be used instead including video evidence.","resolutionSource":"https://www.dotabuff.com","outcomes":["Over","Under"],"prices":["0.495","0.505"],"clobTokenIds":["102869392206319354785538293633206939486298330689116251724417120463000186043","78255460822643376445741029503318172113140607727057289437117398544642638815161"],"positionIds":["590946079608706202334360998224497788251994653590931706841534953667325591552","590946079608706202334360998224497788251994653590931706841534953667325591553"],"event_id":"1247542","event_title":"Dota 2: salamit vs Team Lynx (BO3) - EPL Masters Group A","event_slug":"dota2-salami-lynx-2026-10-25"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:35:31.287Z","event_combo_status":"available","best_bid":0.03,"best_ask":0.96,"spread":0.9299999999999999,"ask_size":7.5,"ask_notional_usd":622.7102,"book_midpoint":0.495,"book_status":"available","book_observed_at":"2026-10-24T19:36:35.813Z","book_timestamp":"2026-10-24T19:36:11.658Z","depth":{"bid_shares":260,"ask_shares":635.07,"ask_notional_usd":622.7102},"book_age_ms_at_observation":24155,"min_order_size":"5","tick_size":"0.01"}
