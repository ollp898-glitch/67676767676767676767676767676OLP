completed.\n\nIn that case, any remaining games required to decide the match, including a game in progress or not yet started, will be counted as won by the winning team.\n\nIf the match ends due to the clinching game being forfeited this will count as a completed match.\n\nThe resolution source for this market will be official information from https://liquipedia.net/mobilelegends/Main_Page. However, if https://liquipedia.net/mobilelegends/Main_Page has not published final results within 2 hours after the event’s conclusion, a consensus of credible reporting may be used instead including video evidence.","resolutionSource":"https://liquipedia.net/mobilelegends/Main_Page","outcomes":["Team Falcons PH","Aurora Gaming PH"],"prices":["0.5","0.5"],"clobTokenIds":["63415864842357530220440214827061353040542884574060265580382278641760918331186","101808312093581120146295423865046312341983978500837493923630118046664702384816"],"positionIds":["648878066990561306461952212134251291243753127366843162851864159716754063360","648878066990561306461952212134251291243753127366843162851864159716754063361"],"event_id":"1247088","event_title":"Mobile Legends Bang Bang: Team Falcons PH vs Aurora Gaming PH (BO7) - MPL Philippines Playoffs","event_slug":"mlbb-falcon-ar-2026-10-25"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:35:20.791Z","event_combo_status":"available","best_bid":0.52,"best_ask":0.55,"spread":0.030000000000000027,"ask_size":11.11,"ask_notional_usd":281.0305,"book_midpoint":0.535,"book_status":"available","book_observed_at":"2026-10-24T19:36:35.684Z","book_timestamp":"2026-10-24T19:36:28.716Z","depth":{"bid_shares":319.87,"ask_shares":320.11,"ask_notional_usd":281.0305},"book_age_ms_at_observation":6968,"min_order_size":"5","tick_size":"0.01"}
