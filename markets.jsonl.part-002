 market will resolve based on the underlying real-world match rather than exact name matching. Recognizable abbreviations, alternate or erroneous spellings, sponsor tags, affiliate or academy designations, regional identifiers, and minor formatting differences will be treated as referring to the same team, provided the intended team can be clearly and uniquely identified within the relevant competition. If a listed team name has no reasonable connection to any participating team, or if it matches or could reasonably refer to another team in the same competition such that the intended team cannot be unambiguously determined, this market will resolve 50-50.","resolutionSource":"https://liquipedia.net/overwatch/Main_Page","outcomes":["Solus Victorem","OU Gaming"],"prices":["0.57","0.43"],"clobTokenIds":["80566755069127468496091065556153908278046816261776642309288624147325110712282","13633686454318120606829064408444403132423910470296537192467101294903416442269"],"positionIds":["745375568203487898869450875534709506303861626763170887764855388758431760384","745375568203487898869450875534709506303861626763170887764855388758431760385"],"event_id":"1247097","event_title":"Overwatch: Solus Victorem vs OU Gaming (BO5) - OCS China Stage 3 Round Robin Stage","event_slug":"ow-sv-oug-2026-10-25"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:35:20.791Z","event_combo_status":"available","best_bid":0.52,"best_ask":0.6,"spread":0.07999999999999996,"ask_size":12.5,"ask_notional_usd":3926.9834,"book_midpoint":0.56,"book_status":"available","book_observed_at":"2026-10-24T19:36:35.684Z","book_timestamp":"2026-10-24T19:36:15.633Z","depth":{"bid_shares":4140.400000000001,"ask_shares":4389.62,"ask_notional_usd":3926.9834},"book_age_ms_at_observation":20051,"min_order_size":"5","tick_size":"0.01"}
