equivocally determined as described above.\nThe primary resolution source for this market will be official ATP statistics; however, a consensus of credible reporting may also be used.","resolutionSource":"https://www.atptour.com/en/scores/current","outcomes":["Over 2.5","Under 2.5"],"prices":["0.36","0.64"],"clobTokenIds":["49523301863855255014945180046503363259847636370725052131973736961602752415883","21631578983757488485014245380618188051931850624145718089534616720642389792074"],"positionIds":["458327932033230965017041063120825701331543954095849899995806830265639108608","458327932033230965017041063120825701331543954095849899995806830265639108609"],"event_id":"1246996","event_title":"Swiss Indoors Basel, Qualification: Rinky Hijikata vs Yannick Hanfmann","event_slug":"atp-hijikat-hanfman-2026-10-25"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:35:21.879Z","event_combo_status":"available","best_bid":0.35,"best_ask":0.37,"spread":0.020000000000000018,"ask_size":100,"ask_notional_usd":1370.9192,"book_midpoint":0.36,"book_status":"available","book_observed_at":"2026-10-24T19:36:35.152Z","book_timestamp":"2026-10-24T19:36:17.693Z","depth":{"bid_shares":6775.55,"ask_shares":1509.8000000000002,"ask_notional_usd":1370.9192},"book_age_ms_at_observation":17459,"min_order_size":"5","tick_size":"0.01"}
