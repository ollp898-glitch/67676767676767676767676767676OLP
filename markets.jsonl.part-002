 market will resolve based on the underlying real-world match rather than exact name matching. Recognizable abbreviations, alternate or erroneous spellings, sponsor tags, affiliate or academy designations, regional identifiers, and minor formatting differences will be treated as referring to the same team, provided the intended team can be clearly and uniquely identified within the relevant competition. If a listed team name has no reasonable connection to any participating team, or if it matches or could reasonably refer to another team in the same competition such that the intended team cannot be unambiguously determined, this market will resolve 50-50.","resolutionSource":"https://hltv.org","outcomes":["Quintessence","TitanFlow"],"prices":["0.5","0.5"],"clobTokenIds":["54424064152881214675640747384063005399600415747438273477201668024416936191202","21623773823327470040900179331324296226414565097764382944181979707302985451481"],"positionIds":["792093755860885835857963370488543700565503783947585600299890841530056835072","792093755860885835857963370488543700565503783947585600299890841530056835073"],"event_id":"1247522","event_title":"Counter-Strike: Quintessence vs TitanFlow (BO3) - CCT Europe Challengers Series Playoffs","event_slug":"cs2-quinte-titanf-2026-10-25"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:35:28.983Z","event_combo_status":"available","best_bid":0.05,"best_ask":0.95,"spread":0.8999999999999999,"ask_size":7.38,"ask_notional_usd":2810.4001999999996,"book_midpoint":0.5,"book_status":"available","book_observed_at":"2026-10-24T19:36:35.797Z","book_timestamp":"2026-10-24T19:36:07.145Z","depth":{"bid_shares":2871.3399999999997,"ask_shares":2871.21,"ask_notional_usd":2810.4001999999996},"book_age_ms_at_observation":28652,"min_order_size":"5","tick_size":"0.01"}
