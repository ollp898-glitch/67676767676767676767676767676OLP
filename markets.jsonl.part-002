 will be official WTA statistics; however, a consensus of credible reporting may also be used.","resolutionSource":"https://www.wtatennis.com/scores","outcomes":["Over 2.5","Under 2.5"],"prices":["0.37","0.63"],"clobTokenIds":["71142706085315382336429546877864696163695630280676292072705852300836716449557","93955164666892173532229057473778360223111486635986344782487353183584124401032"],"positionIds":["688890315601675546416740162710553150734589192294921279803479939469746896896","688890315601675546416740162710553150734589192294921279803479939469746896897"],"event_id":"1246802","event_title":"Ningbo Open: Elena Rybakina vs Leylah Fernandez","event_slug":"wta-rybakin-fernand-2026-10-25"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:35:18.491Z","event_combo_status":"available","best_bid":0.62,"best_ask":0.64,"spread":0.020000000000000018,"ask_size":3740,"ask_notional_usd":49757.651600000005,"book_midpoint":0.63,"book_status":"available","book_observed_at":"2026-10-24T19:36:34.924Z","book_timestamp":"2026-10-24T19:36:04.829Z","depth":{"bid_shares":13047.06,"ask_shares":73384.49,"ask_notional_usd":49757.651600000005},"book_age_ms_at_observation":30095,"min_order_size":"5","tick_size":"0.01"}
