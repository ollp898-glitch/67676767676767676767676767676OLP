et will be official information from https://hltv.org. However, if https://hltv.org has not published final results within 2 hours after the event’s conclusion, a consensus of credible reporting may be used instead including video evidence.","resolutionSource":"https://hltv.org","outcomes":["Over","Under"],"prices":["0.435","0.565"],"clobTokenIds":["108945621042907291636361997707762654684134100746666022614974624522960089820850","102298126376070546162461813356974408037627435734754163507938892662444675612637"],"positionIds":["581696117111171938747812239129880555499533159450939334893858389258374479872","581696117111171938747812239129880555499533159450939334893858389258374479873"],"event_id":"1238707","event_title":"Counter-Strike: Color vs ex-Zero Tenacity (BO3) - NODWIN Clutch Series Playoffs","event_slug":"cs2-color-zerote-2026-10-25"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:34:44.209Z","event_combo_status":"available","best_bid":0.38,"best_ask":0.5,"spread":0.12,"ask_size":10,"ask_notional_usd":389.869,"book_midpoint":0.44,"book_status":"available","book_observed_at":"2026-10-24T19:36:31.088Z","book_timestamp":"2026-10-24T19:35:32.117Z","depth":{"bid_shares":644.5799999999999,"ask_shares":549.7,"ask_notional_usd":389.869},"book_age_ms_at_observation":58971,"min_order_size":"5","tick_size":"0.01"}
