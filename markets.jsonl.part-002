ial Challenger statistics; however, a consensus of credible reporting may also be used.","resolutionSource":"https://www.atptour.com/en/scores/current","outcomes":["Over 2.5","Under 2.5"],"prices":["0.365","0.635"],"clobTokenIds":["33742160549356582752573234083865165429489188363551160203245597899398924653441","63074623921713154055666208537737528459764371483573108555242566133997622503641"],"positionIds":["485689784868973989381861390095055287013250078697680308463492356400348135424","485689784868973989381861390095055287013250078697680308463492356400348135425"],"event_id":"1245573","event_title":"Guangzhou 2: Coleman Wong vs Tristan Schoolkate","event_slug":"atp-wong-schoolk-2026-10-24"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:35:02.023Z","event_combo_status":"available","best_bid":0.35,"best_ask":0.37,"spread":0.020000000000000018,"ask_size":105,"ask_notional_usd":2434.3937,"book_midpoint":0.36,"book_status":"available","book_observed_at":"2026-10-24T19:36:33.659Z","book_timestamp":"2026-10-24T19:35:27.581Z","depth":{"bid_shares":24888.55,"ask_shares":3661.5000000000005,"ask_notional_usd":2434.3937},"book_age_ms_at_observation":66078,"min_order_size":"5","tick_size":"0.01"}
