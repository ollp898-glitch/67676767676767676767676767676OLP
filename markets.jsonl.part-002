 match, including a map in progress or not yet started, will be counted as won by the winning team.\n\nIf the match ends due to the clinching map being forfeited this will count as a completed match.\n\nThe resolution source for this market will be official information from https://vlr.gg. However, if https://vlr.gg has not published final results within 2 hours after the event’s conclusion, a consensus of credible reporting may be used instead including video evidence.","resolutionSource":"https://vlr.gg","outcomes":["Shopify Rebellion Gold","SK Nebula"],"prices":["0.375","0.625"],"clobTokenIds":["6095055270558559314773502413422452877588977013844842715744254163816806585157","19250780030452688955030990948938651551197797111909135272050672453238150954231"],"positionIds":["519865372353414692517953898568485421869085697907357940710193079853483294720","519865372353414692517953898568485421869085697907357940710193079853483294721"],"event_id":"1239230","event_title":"Valorant: Shopify Rebellion Gold vs SK Nebula (BO3) - VCT Game Changers Championship Playoffs","event_slug":"val-srg-skn-2026-10-24"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:34:53.677Z","event_combo_status":"available","best_bid":0.33,"best_ask":0.42,"spread":0.08999999999999997,"ask_size":525.86,"ask_notional_usd":1338.2717,"book_midpoint":0.375,"book_status":"available","book_observed_at":"2026-10-24T19:36:31.088Z","book_timestamp":"2026-10-24T19:36:18.642Z","depth":{"bid_shares":1839.7,"ask_shares":2267.45,"ask_notional_usd":1338.2717},"book_age_ms_at_observation":12446,"min_order_size":"5","tick_size":"0.01"}
