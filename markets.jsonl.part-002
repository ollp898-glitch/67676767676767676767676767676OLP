vocally determined as described above.\nThe primary resolution source for this market will be official WTA statistics; however, a consensus of credible reporting may also be used.","resolutionSource":"https://www.wtatennis.com/scores","outcomes":["Over 2.5","Under 2.5"],"prices":["0.42","0.58"],"clobTokenIds":["67788066317843540075012462504385883028755507024630510416042071782969876451835","74546743003405824219584002660807968642790945087079301382287665132881851598318"],"positionIds":["468910403970403487754624240388969246098054463565778255332092077970292736000","468910403970403487754624240388969246098054463565778255332092077970292736001"],"event_id":"1246800","event_title":"Pan Pacific Open, Qualification: Kimberly Birrell vs Daria Kasatkina","event_slug":"wta-birrell-kasatki-2026-10-24"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:35:18.491Z","event_combo_status":"available","best_bid":0.41,"best_ask":0.43,"spread":0.020000000000000018,"ask_size":145.06,"ask_notional_usd":2948.3375,"book_midpoint":0.42,"book_status":"available","book_observed_at":"2026-10-24T19:36:34.793Z","book_timestamp":"2026-10-24T19:36:23.185Z","depth":{"bid_shares":14630.289999999999,"ask_shares":4428.949999999999,"ask_notional_usd":2948.3375},"book_age_ms_at_observation":11608,"min_order_size":"5","tick_size":"0.01"}
