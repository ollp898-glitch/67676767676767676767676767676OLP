et will be official Challenger statistics; however, a consensus of credible reporting may also be used.","resolutionSource":"https://www.atptour.com/en/scores/current","outcomes":["Over 2.5","Under 2.5"],"prices":["0.355","0.645"],"clobTokenIds":["5128087828947795744069819515296557735429900348869638797148012029406872346721","93463215449081478639541201135002120956275354635138081423317294910850665437292"],"positionIds":["566085574442260712432779852493817354607623850809308222560162919024835952640","566085574442260712432779852493817354607623850809308222560162919024835952641"],"event_id":"1247004","event_title":"Lisbon: Alexander Ritschard vs Svyatoslav Gulin","event_slug":"atp-ritscha-gulin-2026-10-25"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:35:21.715Z","event_combo_status":"available","best_bid":0.34,"best_ask":0.35,"spread":0.009999999999999953,"ask_size":100,"ask_notional_usd":1376.6480999999999,"book_midpoint":0.345,"book_status":"available","book_observed_at":"2026-10-24T19:36:35.156Z","book_timestamp":"2026-10-24T19:35:27.471Z","depth":{"bid_shares":9717.809999999998,"ask_shares":1536.6,"ask_notional_usd":1376.6480999999999},"book_age_ms_at_observation":67685,"min_order_size":"5","tick_size":"0.01"}
