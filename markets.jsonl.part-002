ations, alternate or erroneous spellings, sponsor tags, affiliate or academy designations, regional identifiers, and minor formatting differences will be treated as referring to the same team, provided the intended team can be clearly and uniquely identified within the relevant competition. If a listed team name has no reasonable connection to any participating team, or if it matches or could reasonably refer to another team in the same competition such that the intended team cannot be unambiguously determined, this market will resolve 50-50.","resolutionSource":"https://hltv.org","outcomes":["BESTIA","Imperial"],"prices":["0.345","0.655"],"clobTokenIds":["13498472256542334329244643589790999939575968592194734111555654155552675198219","19400395291289710323385172706759766179483944613631025604454259698711063508479"],"positionIds":["835594463003405336087041061944463211961520959708256600984346196880165699584","835594463003405336087041061944463211961520959708256600984346196880165699585"],"event_id":"1243366","event_title":"Counter-Strike: BESTIA vs Imperial (BO3) - Circuit X Curitiba Playoffs","event_slug":"cs2-bst-imp11-2026-10-24"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:30:03.718Z","event_combo_status":"available","best_bid":0.34,"best_ask":0.35,"spread":0.009999999999999953,"ask_size":44439.59,"ask_notional_usd":109948.11310000002,"book_midpoint":0.345,"book_status":"available","book_observed_at":"2026-10-24T19:36:32.429Z","book_timestamp":"2026-10-24T19:36:27.363Z","depth":{"bid_shares":44239.69,"ask_shares":160271.22,"ask_notional_usd":109948.11310000002},"book_age_ms_at_observation":5066,"min_order_size":"5","tick_size":"0.01"}
