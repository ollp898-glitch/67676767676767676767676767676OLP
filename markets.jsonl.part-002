resolve based on the underlying real-world match rather than exact name matching. Recognizable abbreviations, alternate or erroneous spellings, sponsor tags, affiliate or academy designations, regional identifiers, and minor formatting differences will be treated as referring to the same team, provided the intended team can be clearly and uniquely identified within the relevant competition. If a listed team name has no reasonable connection to any participating team, or if it matches or could reasonably refer to another team in the same competition such that the intended team cannot be unambiguously determined, this market will resolve 50-50.","resolutionSource":"https://hltv.org","outcomes":["eSuba","Team Nemesis Academy"],"prices":["0.52","0.48"],"clobTokenIds":["39333706258045295417967508642619652554783480890946353009740481020000751442620","92595484153961946173872639174500242963708929063858697235586720599410573308513"],"positionIds":["897813120474217117712688387425708429114020697929084222060658941848539103232","897813120474217117712688387425708429114020697929084222060658941848539103233"],"event_id":"1240648","event_title":"Counter-Strike: eSuba vs Team Nemesis Academy (BO3) - CCT Europe Contenders #10 Playoffs","event_slug":"cs2-esb-nemesi-2026-10-25"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:34:47.184Z","event_combo_status":"available","best_bid":0.15,"best_ask":0.89,"spread":0.74,"ask_size":23.88,"ask_notional_usd":20913.3446,"book_midpoint":0.52,"book_status":"available","book_observed_at":"2026-10-24T19:36:31.446Z","book_timestamp":"2026-10-24T19:35:42.626Z","depth":{"bid_shares":10426.49,"ask_shares":21193.46,"ask_notional_usd":20913.3446},"book_age_ms_at_observation":48820,"min_order_size":"5","tick_size":"0.01"}
