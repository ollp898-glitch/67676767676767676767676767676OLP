et":{"id":"6139892","conditionId":"0xc98724f4691b7c5d14e0084a2c0f284eef9ee02f2a1d3c5562dedb8dad448e7a","question":"Sayaka Ishii vs. Yulia Putintseva: Total Sets O/U 2.5","slug":"wta-ishii-putints-2026-10-25-set-totals-2pt5","sportsMarketType":"tennis_set_totals","groupItemTitle":"Pan Pacific Open, Qualification: Sayaka Ishii vs Yulia Putintseva Total Sets: O/U 2.5","line":2.5,"description":"This market refers to the tennis match between Sayaka Ishii and Yulia Putintseva in the Pan Pacific Open, Qualification, originally scheduled for October 25, 2026 at 12:30AM ET.\nIf the match is played to completion, this market will resolve to \"Over\" if the total number of sets played equals or exceeds 3, and to \"Under\" otherwise. A set counts as played once it has begun, even if it is not played to completion. A super tie breaker is considered as one (1) set.\nIf the match is postponed or suspended, this market will remain open until the match has been completed. A postponement alone will not trigger a 50-50 resolution.\nIf a player retires, withdraws, is defaulted, or is disqualified, or the match otherwise begins but is not completed, this market will resolve based on any outcome that was already unequivocally determined at the time play stopped. An outcome is considered unequivocally determined if it would have been guaranteed under every possible completion of the match played according to the match format published by the tournament organizer for that round. For example, for a line of 2.5, if play stops with the players at one set each, completing the match would have required at least one additional set, resulting in at least 3 sets played, so \"Over\" would resolve as the winning outcome. If neither outcome was already determined at the time play stopped, this market will resolve 50-50.\nIf the match is canceled, or has not been completed by November 8, 2026, 11:59 PM ET, this market will resolve 50-50, unless an outcome was already unequivocally determined as described above.\nThe primary resolution source for this market will be official WTA statistics; however, a consensus of credible reporting may also be used.","resolutionSource":"https://www.wtatennis.com/scores","outcomes":["Over 2.5","Under 2.5"],"prices":["0.235","0.765"],"clobTokenIds":["66329868055937933283293125116479046696451371635210229729233307004824059684533","18039230925200506841236104658033114277705617665209092637086986379416611505772"],"positionIds":["875685816983149080162572883573130434041164203922491189760266388275273400320","875685816983149080162572883573130434041164203922491189760266388275273400321"],"event_id":"1246803","event_title":"Pan Pacific Open, Qualification: Sayaka Ishii vs Yulia Putintseva","event_slug":"wta-ishii-putints-2026-10-25"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:35:18.491Z","event_combo_status":"available","best_bid":0.22,"best_ask":0.24,"spread":0.01999999999999999,"ask_size":5,"ask_notional_usd":1320.0854000000002,"book_midpoint":0.22999999999999998,"book_status":"available","book_observed_at":"2026-10-24T19:36:34.924Z","book_timestamp":"2026-10-24T19:36:17.738Z","depth":{"bid_shares":7405.71,"ask_shares":1391.59,"ask_notional_usd":1320.0854000000002},"book_age_ms_at_observation":17186,"min_order_size":"5","tick_size":"0.01"}
