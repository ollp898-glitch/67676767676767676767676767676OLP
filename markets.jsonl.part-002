{"snapshot_at":"2026-10-24T19:29:44.630Z","price_observed_at":"2026-10-24T19:30:01.630Z","event_id":"1247542","event_title":"Dota 2: salamit vs Team Lynx (BO3) - EPL Masters Group A","event_slug":"dota2-salami-lynx-2026-10-25","market_id":"6148768","condition_id":"0xdcc5f83939488714d3ade5df28b6751a6ce284619616957c843506edb6d7233e","market_slug":"dota2-salami-lynx-2026-10-25-game1-any-player-rampage","question":"Game 1: Any Player Rampage?","group_item_title":"Any Player Rampage","market_type":"dota2_rampage","line":null,"game_start_time":"2026-10-25T09:00:00.000Z","sport":"esports","sport_source":"sports_metadata_series","league_code":"dota2","league_name":"Dota 2","league_series_id":"10309","liquidity":4,"volume":null,"volume_24h":null,"accepting_orders":true,"order_book":true,"gamma_combo_status":"enabled","gamma_best_bid":0.01,"gamma_best_ask":0.99,"gamma_spread":0.98,"schema_version":1,"match_id":"match-f8367c9667b6597423e47cb0","market_question":"Game 1: Any Player Rampage?","league":"Dota 2","market_url":"https://polymarket.com/event/dota2-salami-lynx-2026-10-25?tid=96596199256462509043828872948128901643803948656734386845093802098002094159072","event_url":"https://polymarket.com/event/dota2-salami-lynx-2026-10-25","outcome_id":"token:96596199256462509043828872948128901643803948656734386845093802098002094159072","token_id":"96596199256462509043828872948128901643803948656734386845093802098002094159072","position_id":"644695695243701630996592128892044695651076560320405311135071935804081176576","outcome_index":0,"outcome":"Yes","raw_outcome":"Yes","price":0.5,"probability_percent":50,"market_line":null,"outcome_line":null,"period":"map_1","family":"rampage","classification_status":"classified","selection_status":"eligible","exclusion_reason":null,"classification_source":"market_type","classification_note":null,"source_market":{"id":"6148768","conditionId":"0xdcc5f83939488714d3ade5df28b6751a6ce284619616957c843506edb6d7233e","question":"Game 1: Any Player Rampage?","slug":"dota2-salami-lynx-2026-10-25-game1-any-player-rampage","sportsMarketType":"dota2_rampage","groupItemTitle":"Any Player Rampage","description":"This market is about whether any player achieves a Rampage during Game 1. In Dota 2, a Rampage occurs when a single player kills all 5 enemy heroes in rapid succession without dying.\n\nThis market will resolve to \"Yes\" if any player on either team achieves a Rampage during Game 1. This market will resolve to \"No\" if no player achieves a Rampage.\n\nIf the match is canceled (not played at all), this market will resolve to 50-50.\n\nIf the match is postponed, it must be rescheduled to a start time on or before November 8, 2026 at 11:59 PM ET (14 calendar days after the originally scheduled start of October 25, 2026 at 5:00 AM ET). If, by that deadline, the most recently announced rescheduled start time is on or before the deadline, this market resolves based on the result of the match as played. Otherwise, this market resolves 50-50, regardless of whether the match is subsequently played.\n\nIf Game 1 is never played due to forfeit, disqualification, or walkover, this market will resolve to 50-50.\n\nIf Game 1 is not played because the series result has already been determined (e.g., a team clinches the series before Game 1 is needed), this market will resolve to 50-50.\n\nIf Game 1 begins but is not completed and ends via forfeit, this market will resolve based on whether a Rampage occurred prior to stoppage. If no Rampage occurred, this market will resolve to \"No\".\n\nIf Game 1 is remade, resolution will be based on the remade game only.\n\nThe resolution source for this market will be official information from https://www.dotabuff.com. However, if https://www.dotabuff.com has not published final results within 2 hours after the event's conclusion, a consensus of credible reporting may be used instead including video evidence.","resolutionSource":"https://www.dotabuff.com","outcomes":["Yes","No"],"prices":["0.5","0.5"],"clobTokenIds":["96596199256462509043828872948128901643803948656734386845093802098002094159072","60839267658887714150365893930778909185500392558540552046046983798937452780154"],"positionIds":["644695695243701630996592128892044695651076560320405311135071935804081176576","644695695243701630996592128892044695651076560320405311135071935804081176577"],"event_id":"1247542","event_title":"Dota 2: salamit vs Team Lynx (BO3) - EPL Masters Group A","event_slug":"dota2-salami-lynx-2026-10-25"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:35:31.287Z","event_combo_status":"available","best_bid":0.02,"best_ask":0.98,"spread":0.96,"ask_size":10,"ask_notional_usd":207.8,"book_midpoint":0.5,"book_status":"available","book_observed_at":"2026-10-24T19:36:35.813Z","book_timestamp":"2026-10-24T19:34:49.039Z","depth":{"bid_shares":210,"ask_shares":210,"ask_notional_usd":207.8},"book_age_ms_at_observation":106774,"min_order_size":"5","tick_size":"0.01"}
