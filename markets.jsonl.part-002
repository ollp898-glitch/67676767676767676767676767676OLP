l WTA statistics; however, a consensus of credible reporting may also be used.","resolutionSource":"https://www.wtatennis.com/scores","outcomes":["Over","Under"],"prices":["0.495","0.505"],"clobTokenIds":["78195080052477429111013649594883635943458372175027071088321222613110214446159","39789786311939439176031345462126463217474677491522233653925063876048543698386"],"positionIds":["547951474778019084159507792825360650827247952274741447639425252177150476288","547951474778019084159507792825360650827247952274741447639425252177150476289"],"event_id":"1245417","event_title":"Guangzhou Open, Qualification: Carol Young Suh Lee vs Elena Pridankina","event_slug":"wta-lee-pridank-2026-10-24"},"combo_status":"available","combo_verified":true,"combo_verification_status":"verified","combo_verified_at":"2026-10-24T19:35:01.412Z","event_combo_status":"available","best_bid":0.5,"best_ask":0.51,"spread":0.010000000000000009,"ask_size":205,"ask_notional_usd":3895.690900000001,"book_midpoint":0.505,"book_status":"available","book_observed_at":"2026-10-24T19:36:33.572Z","book_timestamp":"2026-10-24T19:36:33.294Z","depth":{"bid_shares":7137.95,"ask_shares":7139.38,"ask_notional_usd":3895.690900000001},"book_age_ms_at_observation":278,"min_order_size":"5","tick_size":"0.01"}
